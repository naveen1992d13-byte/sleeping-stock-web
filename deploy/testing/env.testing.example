# Copy to /opt/nmts-testing/backend/.env on the host. Do not commit secrets.
# Production backend/.env must never be replaced with this file.

APP_ENV=testing
DB_NAME=nmts_testing
SECRET_KEY=generate-a-unique-testing-jwt-secret
CORS_ORIGINS=https://testing.sleepingstock.in
PUBLIC_API_BASE_URL=https://testing.sleepingstock.in/api

# Same DocumentDB cluster as production; different database name above.
DOCDB_SECRET_ID=nmts/documentdb/credentials
DOCDB_TLS_CA_FILE=/home/ec2-user/sleeping-stock-web/backend/certs/global-bundle.pem
AWS_REGION=ap-south-1

# Same bucket, isolated key prefix via NMTS_STORAGE_ENV (keys are testing/...).
NMTS_S3_BUCKET=nmts-sleeping-stock-archive
NMTS_STORAGE_ENV=testing
ARCHIVE_PRUNE_ENABLED=false
ARCHIVE_SCHEDULER_ENABLED=false
NMTS_DISABLE_DEFAULT_MASTER_SEED=true

# Required for overlay mode: dedicated Production read-only credentials.
# Operator steps (do not commit the password):
#   1. In DocumentDB admin DB create a user that can read db nmts only:
#        db.createUser({
#          user: "nmts_testing_readonly",
#          pwd: "<generated-secret>",
#          roles: [{ role: "read", db: "nmts" }]
#        })
#   2. Put the URI in MONGO_READONLY_URL on this Testing host, or store it as
#      Secrets Manager secret DOCDB_READONLY_SECRET_ID (preferred).
#   3. Never grant readWrite. Never use the Production application user.
#   4. Testing overlay mode refuses to start if this is unset.
MONGO_READONLY_URL=
# DOCDB_READONLY_SECRET_ID=nmts/documentdb/readonly
TESTING_LIVE_GITHUB_MERGE=false
TESTING_LIVE_CLEANUP=false
TESTING_OVERLAY_MODE=true


WHATSAPP_TEST_MODE=true
WHATSAPP_TEST_RECIPIENT_NUMBER=
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=testing.master@sleepingstock.in
# OAuth as naveen@sleepingstock.in. notifications@ is Send-as only.
GMAIL_OAUTH_USER=naveen@sleepingstock.in
GMAIL_FROM_EMAIL=notifications@sleepingstock.in
GMAIL_FROM_NAME=Sleeping Stock
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
