[Unit]
Description=NMTS testing backend (uvicorn on 127.0.0.1:8001)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/nmts-testing/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/nmts-testing/backend/venv/bin/python -m uvicorn server:socket_app --host 127.0.0.1 --port 8001
ExecStartPost=/bin/bash -c 'for i in $(seq 1 45); do /usr/bin/curl -fsS http://127.0.0.1:8001/api/maintenance/status >/dev/null && exit 0; sleep 1; done; echo "nmts-backend-testing health check failed" >&2; exit 1'
TimeoutStartSec=90
TimeoutStopSec=45
Restart=on-failure
RestartSec=5
# Cap Testing RSS on the shared t3.micro (913 MiB). Prefer Testing as the OOM
# victim so Production :8000 is never selected first.
MemoryMax=400M
MemoryHigh=350M
OOMScoreAdjust=500

# Never bind 8000 — that is the production backend.

[Install]
WantedBy=multi-user.target
