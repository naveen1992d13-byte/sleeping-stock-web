{
  "name": "NMTS Sleeping Stock Web",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && ARCHIVE_PRUNE_ENABLED=false ./venv/bin/python -m uvicorn server:socket_app --host 0.0.0.0 --port 8000"
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm start"
    }
  ],
  "ports": [8000, 3000]
}
