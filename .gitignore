
# Python cache files
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Python virtualenvs (must never be committed: interpreter symlinks and
# console-script shebangs are machine-specific and break on other hosts)
venv/
.venv/

# Mobile / Node
node_modules/
mobile/node_modules/
.expo/

# OS / editor noise
.DS_Store

# Local object-store fallback used when AWS is unavailable (never commit blobs)
backend/.local_object_store/
frontend/.env.local
backend/report_files/
backend/notice_files/
backend/query_attachments/
backend/mobile_apk_storage/

# Local AWS mapping override (never commit)
backend/.env.s3.local
.env.s3.local

# EC2-local secrets and TLS material (never commit)
backend/.env.backup
backend/certs/

# Generated testing-only metadata (never commit)
backend/deployment.json
backend/testing_snapshot_active.json

