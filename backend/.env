# NMTS / Sleeping Stock — backend environment template.
# Copy this file to `.env` in the same folder and fill in real values there.
# Never commit the real `.env` file — it is already covered by .gitignore.

# --- Core app (fill with your existing working values) ---
MONGO_URL=mongodb+srv://naveen1992d13_db_user:prTr74XQRCNrlbLY@cluster0.d0xxpyk.mongodb.net
DB_NAME=nmts
SECRET_KEY=change-this-secret-in-production
CORS_ORIGINS=*

# --- Gmail SMTP (App Password only — never your normal Gmail password) ---
# Either naming style works — notifications.py checks GMAIL_SMTP_* first and
# falls back to the plain SMTP_* names below if those are what's already set:
#   SMTP_HOST, SMTP_PORT, SMTP_EMAIL, SMTP_PASSWORD, SMTP_FROM_NAME
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=sleepingstock@gmail.com
GMAIL_SMTP_APP_PASSWORD=hjpsuizssdxtwtdw
GMAIL_SENDER_NAME=Sleeping Stock - NMTS

# --- WhatsApp Cloud API (official Meta Business Cloud API only) ---
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# WHATSAPP_TEST_MODE=true routes every WhatsApp notification to
# WHATSAPP_TEST_RECIPIENT_NUMBER only, ignoring database recipient numbers.
# Set WHATSAPP_TEST_MODE=false to use real per-user recipient numbers instead
# (production behavior — see UPDATE_NOTES.txt for what that requires).
WHATSAPP_TEST_MODE=true
WHATSAPP_TEST_RECIPIENT_NUMBER=

# --- Sleeping Stock Mobile (mobile_api.py) ---
# No new secrets are required — mobile_api.py reuses the same MONGO_URL/
# DB_NAME above and the existing bcrypt password context. App version /
# APK metadata (name, version, download URL, mandatory flag) is now managed
# entirely from NMTS Web -> Sleeping Stock Mobile -> App & Settings and
# stored in the mobile_app_versions collection, NOT environment variables.
# The old SLEEPING_STOCK_MOBILE_VERSION / SLEEPING_STOCK_MOBILE_APK_URL /
# NMTS_MOBILE_VERSION / NMTS_MOBILE_APK_URL variables (read by the removed
# legacy /mobile/app-info route) are no longer used and can be deleted.

# Public HTTPS base URL embedded into mobile pairing QR codes.
# Production example: https://api.sleepingstock.in/api
# Codespaces testing example: https://<codespace>-8000.app.github.dev/api
# Leave blank only when the reverse proxy provides correct X-Forwarded-Proto/Host.
PUBLIC_API_BASE_URL=

# Hybrid storage (MongoDB + S3) — non-secret defaults
NMTS_STORAGE_ENV=dev
PRODUCT_MONGO_HOT_DAYS=90
VERIFICATION_MONGO_HOT_DAYS=90
ARCHIVE_PRUNE_ENABLED=false
ARCHIVE_SCHEDULER_ENABLED=true
# Set NMTS_S3_BUCKET (+ AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) in deployment secrets.
